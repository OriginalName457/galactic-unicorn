+    else if(play_mode == PLAYING_STREAM) {
+      stream_out = stream_out + stream_dma_len;       // the chunk that just finished
+      uint32_t waiting = stream_in - stream_out;
+      if(waiting == 0) {                              // ran dry: keep the amp fed with silence (no pops)
+        stream_dma_len = 0;
+        stream_dry = stream_dry + 1;
+        dma_channel_transfer_from_buffer_now(audio_dma_channel, stream_silence, 64);
+      }
+      else {
+        uint32_t at = stream_out % STREAM_SIZE;
+        uint32_t n = waiting < STREAM_CHUNK ? waiting : STREAM_CHUNK;
+        if(n > STREAM_SIZE - at) n = STREAM_SIZE - at;   // up to the end of the ring; the rest next time
+        stream_dma_len = n;
+        dma_channel_transfer_from_buffer_now(audio_dma_channel, &stream_buffer[at], n);
+      }
+    }
     else {
       play_mode = NOT_PLAYING;
     }
   }
 
+  void GalacticUnicorn::start_stream() {
+    stop_playing();
+    if(unicorn == this) {
+      stream_in = stream_out = stream_dma_len = stream_dry = 0;
+      pio_sm_set_enabled(audio_pio, audio_sm, true);
+      play_mode = PLAYING_STREAM;
+      next_audio_sequence();
+    }
+  }
+
+  uint32_t GalacticUnicorn::stream_write(const uint8_t *data, uint32_t length) {
+    if(play_mode != PLAYING_STREAM) start_stream();
+    uint32_t space = STREAM_SIZE - (stream_in - stream_out);   // never touches the chunk being played
+    uint32_t n = length / 2;
+    if(n > space) n = space;
+    uint32_t at = stream_in;
+    for(uint32_t i = 0; i < n; i++) {               // byte by byte: Python's buffer may not be 2-byte aligned
+      int32_t sample = (int16_t)(data[2 * i] | (data[2 * i + 1] << 8));
+      stream_buffer[(at + i) % STREAM_SIZE] = (int16_t)((sample * volume) >> 8);
+    }
+    __asm volatile ("dmb" ::: "memory");          // samples land before the DMA can see them
+    stream_in = at + n;
+    return n * 2;
+  }
+
+  uint32_t GalacticUnicorn::stream_level() {
+    return play_mode == PLAYING_STREAM ? stream_in - stream_out : 0;
+  }
+
+  uint32_t GalacticUnicorn::stream_underruns() {
+    return stream_dry;
+  }
