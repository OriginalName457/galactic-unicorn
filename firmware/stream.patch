+// Audio streaming (see stream_write): written by Python, read by the DMA interrupt. Positions count samples
+// forever (wrapping at 2^32 is harmless); the index into the buffer is position % STREAM_SIZE.
+static int16_t stream_buffer[pimoroni::GalacticUnicorn::STREAM_SIZE];
+static volatile uint32_t stream_in = 0;         // samples written so far
+static volatile uint32_t stream_out = 0;        // samples played so far
+static volatile uint32_t stream_dma_len = 0;    // samples in the chunk the DMA is sending right now
+static volatile uint32_t stream_dry = 0;
+static const uint32_t STREAM_CHUNK = 256;       // ~12 ms per interrupt
+static int16_t stream_silence[64] = {0};
+
